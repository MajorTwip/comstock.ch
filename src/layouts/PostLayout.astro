---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import type { Post } from '../lib/posts';
import { formatDate, useTranslations, readingMinutes } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { post: Post; lang: Lang }
const { post, lang } = Astro.props;
const t = useTranslations(lang);
const { data, body } = post;
const minutes = readingMinutes(body ?? '');
const ogImage = data.image?.src;
---

<BaseLayout
  title={`${data.title} · COMSTOCK`}
  description={data.summary}
  image={ogImage}
  publishedTime={data.date.toISOString()}
>
  <article class="mx-auto" data-pagefind-body>
    <header class="mb-8 border-b border-[var(--border)] pb-6">
      {data.draft && <span class="mb-2 inline-block rounded bg-amber-200 px-2 py-0.5 text-xs font-semibold text-amber-900">{t('post.draft')}</span>}
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl" data-pagefind-meta="title">{data.title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--fg-muted)]">
        <time datetime={data.date.toISOString()}>{formatDate(data.date, lang)}</time>
        <span>·</span>
        <span>{minutes} {t('post.readingTime')}</span>
        {data.series && (<><span>·</span><span>{t('post.series')}: {data.series.title}</span></>)}
      </div>
      {
        data.tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2 text-xs">
            {data.tags.map((tag) => <li class="rounded bg-[var(--chip)] px-2 py-0.5 text-[var(--fg-muted)]">#{tag}</li>)}
          </ul>
        )
      }
    </header>

    {data.image && <Image src={data.image} alt={data.title} class="mb-8 w-full rounded-lg" />}

    <div class="prose prose-zinc max-w-none dark:prose-invert prose-img:rounded-lg prose-a:text-[var(--brand)]">
      <slot />
    </div>

    <footer class="mt-12 border-t border-[var(--border)] pt-6" data-pagefind-ignore>
      <a href={`/${lang}/`} class="text-sm text-[var(--brand)] hover:underline">← {t('post.allPosts')}</a>
    </footer>
  </article>
</BaseLayout>
