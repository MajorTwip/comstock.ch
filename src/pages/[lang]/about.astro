---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'de' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const authors = await getCollection('authors');
const author = authors.find((a) => a.data.language === lang) ?? authors[0];
const { Content } = await render(author);
const { data } = author;
---

<BaseLayout title={`${t('nav.about')} · COMSTOCK`}>
  <h1 class="mb-6 text-3xl font-bold tracking-tight">{t('nav.about')}</h1>
  <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start">
    {data.avatar && <Image src={data.avatar} alt={data.name} width={160} height={160} class="rounded-full" />}
    <div>
      <h2 class="text-2xl font-semibold">{data.name}</h2>
      {data.occupation && <p class="text-[var(--fg-muted)]">{data.occupation}{data.company ? ` · ${data.company}` : ''}</p>}
      <div class="mt-2 flex flex-wrap gap-3 text-sm">
        {data.email && <a class="text-[var(--brand)] hover:underline" href={`mailto:${data.email}`}>{data.email}</a>}
        {data.github && <a class="text-[var(--brand)] hover:underline" href={data.github}>GitHub</a>}
      </div>
    </div>
  </div>
  <div class="prose prose-zinc mt-8 max-w-none dark:prose-invert">
    <Content />
  </div>
</BaseLayout>
