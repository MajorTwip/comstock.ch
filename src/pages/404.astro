---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · COMSTOCK">
  <div class="py-20 text-center">
    <h1 class="text-6xl font-bold">404</h1>
    <p class="mt-4 text-lg text-[var(--fg-muted)]">Seite nicht gefunden · Page not found</p>
    <div class="mt-6 flex justify-center gap-4">
      <a href="/de/" class="text-[var(--brand)] hover:underline">Startseite</a>
      <a href="/en/" class="text-[var(--brand)] hover:underline">Home</a>
    </div>
  </div>
</BaseLayout>
