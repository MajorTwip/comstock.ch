---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = `/${lang}`;

const nav = [
  { href: `${base}/`, label: t('nav.home') },
  { href: `${base}/about/`, label: t('nav.about') },
];

const path = Astro.url.pathname;
---

<header class="border-b border-[var(--border)]">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-4">
    <a href={`${base}/`} class="flex items-center gap-2 text-lg font-bold tracking-tight whitespace-nowrap">
      <img src="/static/logo.svg" alt="COMSTOCK" width="36" height="36" class="h-9 w-9" />
      <span>COMSTOCK <span class="text-[var(--brand)]">Projects</span></span>
    </a>
    <nav class="flex items-center gap-4">
      <ul class="hidden gap-4 text-sm sm:flex">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'hover:text-[var(--brand)]',
                  path === item.href ? 'font-semibold text-[var(--brand)]' : 'text-[var(--fg-muted)]',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        data-open-search
        class="rounded p-2 text-[var(--fg-muted)] hover:bg-[var(--chip)] hover:text-[var(--fg)]"
        aria-label={t('nav.search')}
        title={`${t('nav.search')} (Ctrl/⌘ K)`}
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
        </svg>
      </button>
      <LangSwitch />
      <ThemeToggle />
    </nav>
  </div>
</header>
