---
import { Image } from 'astro:assets';
import type { Post } from '../lib/posts';
import { postSlug } from '../lib/posts';
import { formatDate } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { post: Post; lang: Lang }
const { post, lang } = Astro.props;
const slug = postSlug(post);
const href = `/${lang}/blog/${slug}/`;
---

<article class="flex flex-col gap-3 border-b border-[var(--border)] py-6 last:border-0 sm:flex-row">
  {
    post.data.image && (
      <a href={href} class="shrink-0">
        <Image
          src={post.data.image}
          alt={post.data.title}
          width={200}
          height={134}
          class="h-28 w-full rounded object-cover sm:w-48"
        />
      </a>
    )
  }
  <div class="flex flex-col gap-1">
    <time datetime={post.data.date.toISOString()} class="text-sm text-[var(--fg-muted)]">
      {formatDate(post.data.date, lang)}
    </time>
    <h2 class="text-xl font-semibold">
      <a href={href} class="hover:text-[var(--brand)]">{post.data.title}</a>
    </h2>
    {post.data.summary && <p class="text-[var(--fg-muted)]">{post.data.summary}</p>}
    {
      post.data.tags.length > 0 && (
        <ul class="mt-1 flex flex-wrap gap-2 text-xs text-[var(--fg-muted)]">
          {post.data.tags.map((tag) => <li class="rounded bg-[var(--chip)] px-2 py-0.5">#{tag}</li>)}
        </ul>
      )
    }
  </div>
</article>
